TZ={{ pihole_environment_variables_tz }}

{# The image's entrypoint gives its `pihole` user this uid and gid, then starts Pi-hole as that user. #}
PIHOLE_UID={{ pihole_uid }}
PIHOLE_GID={{ pihole_gid }}

FTLCONF_webserver_api_password={{ pihole_environment_variables_ftlconf_webserver_api_password }}

{# Pi-hole redirects `/` to its web interface only for requests to this name. #}
FTLCONF_webserver_domain={{ pihole_hostname }}
FTLCONF_webserver_port={{ pihole_container_http_port }}
{% if pihole_path_prefix != '/' %}
{# Traefik strips the prefix (see `labels.j2`). Pi-hole puts it back in the links it sends. #}
FTLCONF_webserver_paths_prefix={{ pihole_path_prefix }}
{% endif %}

FTLCONF_dns_listeningMode={{ pihole_environment_variables_ftlconf_dns_listening_mode }}

{{ pihole_environment_variables_additional_variables }}
