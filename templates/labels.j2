{% if pihole_container_labels_traefik_enabled %}
traefik.enable=true

{% if pihole_container_labels_traefik_docker_network %}
traefik.docker.network={{ pihole_container_labels_traefik_docker_network }}
{% endif %}

{% set middlewares = [] %}

{% if pihole_container_labels_traefik_middleware_basic_auth_enabled %}
{% set middlewares = middlewares + [pihole_identifier + '-basic-auth'] %}
traefik.http.middlewares.{{ pihole_identifier }}-basic-auth.basicauth.users={{ pihole_container_labels_traefik_middleware_basic_auth_users }}
{% endif %}

{% if pihole_container_labels_traefik_path_prefix != '/' %}
traefik.http.middlewares.{{ pihole_identifier }}-slashless-redirect.redirectregex.regex=^({{ pihole_container_labels_traefik_path_prefix | quote }})$
traefik.http.middlewares.{{ pihole_identifier }}-slashless-redirect.redirectregex.replacement=${1}/
{% set middlewares = middlewares + [pihole_identifier + '-slashless-redirect'] %}
{% endif %}

{% if pihole_container_labels_traefik_path_prefix != '/' %}
traefik.http.middlewares.{{ pihole_identifier }}-strip-prefix.stripprefix.prefixes={{ pihole_container_labels_traefik_path_prefix }}
{% set middlewares = middlewares + [pihole_identifier + '-strip-prefix'] %}
{% endif %}

{% if pihole_container_labels_traefik_additional_request_headers.keys() | length > 0 %}
{% for name, value in pihole_container_labels_traefik_additional_request_headers.items() %}
traefik.http.middlewares.{{ pihole_identifier }}-add-request-headers.headers.customrequestheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [pihole_identifier + '-add-request-headers'] %}
{% endif %}

{% if pihole_container_labels_traefik_additional_response_headers.keys() | length > 0 %}
{% for name, value in pihole_container_labels_traefik_additional_response_headers.items() %}
traefik.http.middlewares.{{ pihole_identifier }}-add-response-headers.headers.customresponseheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [pihole_identifier + '-add-response-headers'] %}
{% endif %}

traefik.http.routers.{{ pihole_identifier }}.rule={{ pihole_container_labels_traefik_rule }}
{% if pihole_container_labels_traefik_priority | int > 0 %}
traefik.http.routers.{{ pihole_identifier }}.priority={{ pihole_container_labels_traefik_priority }}
{% endif %}
traefik.http.routers.{{ pihole_identifier }}.service={{ pihole_identifier }}
{% if middlewares | length > 0 %}
traefik.http.routers.{{ pihole_identifier }}.middlewares={{ middlewares | join(',') }}
{% endif %}
traefik.http.routers.{{ pihole_identifier }}.entrypoints={{ pihole_container_labels_traefik_entrypoints }}
traefik.http.routers.{{ pihole_identifier }}.tls={{ pihole_container_labels_traefik_tls | to_json }}
{% if pihole_container_labels_traefik_tls %}
traefik.http.routers.{{ pihole_identifier }}.tls.certResolver={{ pihole_container_labels_traefik_tls_certResolver }}
{% endif %}

traefik.http.services.{{ pihole_identifier }}.loadbalancer.server.port={{ pihole_container_http_port }}
{% endif %}

{% for arg in pihole_container_labels_additional_labels %}
{{ arg }}
{% endfor %}
